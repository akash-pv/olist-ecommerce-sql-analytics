Q15: View for a dashboard tool: monthly_sales_summary
RUN AS BLOCK step 1: select ONLY the CREATE VIEW statement below and
click the lightning bolt.
CREATE OR REPLACE VIEW monthly_sales_summary AS
SELECT DATE_FORMAT(o.order_purchase_timestamp, '%Y-%m') AS order_month,
COUNT(DISTINCT o.order_id) AS orders,
SUM(oi.price) AS revenue,
SUM(oi.freight_value) AS freight,
ROUND(SUM(oi.price) / COUNT(DISTINCT o.order_id), 2) AS avg_order_value
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY DATE_FORMAT(o.order_purchase_timestamp, '%Y-%m');
Q15 step 2: read the view like a table
README screenshot: monthly_sales_summary_view.png
SELECT * FROM monthly_sales_summary ORDER BY order_month;
 
Q16: Stored procedure: full order history for one customer
RUN AS BLOCK step 1: select everything from DROP PROCEDURE down to the
last "DELIMITER ;" line and click the lightning bolt.
DROP PROCEDURE IF EXISTS get_customer_history;
DELIMITER //
CREATE PROCEDURE get_customer_history(
IN p_customer_unique_id VARCHAR(50)
)
BEGIN
SELECT
o.order_id,
o.order_status,
o.order_purchase_timestamp,
COUNT(oi.order_item_id) AS items,
COALESCE(SUM(oi.price), 0) AS order_value
FROM customers c
JOIN orders o
ON c.customer_id = o.customer_id
LEFT JOIN order_items oi
ON o.order_id = oi.order_id
WHERE c.customer_unique_id = p_customer_unique_id
GROUP BY
o.order_id,
o.order_status,
o.order_purchase_timestamp
ORDER BY o.order_purchase_timestamp;
END //
DELIMITER ;
