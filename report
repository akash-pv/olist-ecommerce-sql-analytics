PART B: INTERMEDIATE (JOINs, GROUP BY, HAVING, aggregates)
=====================================================================
Q06: What is the total revenue generated so far? (delivered orders)
README screenshot: intermediate_q1_revenue.png
SELECT SUM(oi.price) AS total_revenue,
SUM(oi.freight_value) AS total_freight
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered';
 
Q06 check: payments received on delivered orders
SELECT SUM(p.payment_value) AS total_paid
FROM orders o
JOIN payments p ON o.order_id = p.order_id
WHERE o.order_status = 'delivered';
 
Q07: Which product category has sold the most units? (delivered orders)
README screenshot: intermediate_q2_top_categories.png
SELECT COALESCE(t.product_category_name_english, NULLIF(p.product_category_name, ''), 'unknown') AS category,
COUNT(*) AS units_sold
FROM order_items oi
JOIN orders o ON oi.order_id = o.order_id
JOIN products p ON oi.product_id = p.product_id
LEFT JOIN category_translation t ON p.product_category_name = t.product_category_name
WHERE o.order_status = 'delivered'
GROUP BY category
ORDER BY units_sold DESC
LIMIT 10;
 
Q08: Top 5 customers by total amount spent (delivered orders)
SELECT c.customer_unique_id,
SUM(oi.price) AS total_spent
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_unique_id
ORDER BY total_spent DESC
LIMIT 5;
 
Q09: Sellers generating more than R$10,000 in revenue
SELECT
s.seller_id,
s.seller_city,
r.total_revenue
FROM sellers s
JOIN (
SELECT
oi.seller_id,
SUM(oi.price) AS total_revenue
FROM order_items oi
JOIN orders o
ON oi.order_id = o.order_id
WHERE o.order_status = 'delivered'
GROUP BY oi.seller_id
HAVING SUM(oi.price) > 10000
) r
ON s.seller_id = r.seller_id
ORDER BY r.total_revenue DESC;
 
Q10: Average order value per customer city (cities with 50+ orders)
The inner query adds items up to one row per order first.
SELECT city, ROUND(AVG(order_value), 2) AS avg_order_value, COUNT(*) AS orders
FROM (
SELECT c.customer_city AS city,
o.order_id,
SUM(oi.price) AS order_value
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_city, o.order_id
) AS order_totals
GROUP BY city
HAVING COUNT(*) >= 50
ORDER BY avg_order_value DESC
LIMIT 10;
 
Q11: Orders handled and average payment value per payment type
Delivered orders only; aggregate instalments per order first.
SELECT
payment_type,
COUNT(*) AS orders_handled,
ROUND(AVG(order_payment), 2) AS avg_payment_value
FROM (
SELECT
p.order_id,
p.payment_type,
SUM(p.payment_value) AS order_payment
FROM payments p
JOIN orders o
ON p.order_id = o.order_id
WHERE o.order_status = 'delivered'
GROUP BY p.order_id, p.payment_type
) AS payment_summary
GROUP BY payment_type
ORDER BY orders_handled DESC;
 
