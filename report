Q19: Is revenue growing? Month-over-month growth (window function LAG)
Needs the view from Q15. Early 2016 months have very few orders.
SELECT order_month,
revenue,
LAG(revenue) OVER (ORDER BY order_month) AS previous_month_revenue,
ROUND((revenue - LAG(revenue) OVER (ORDER BY order_month))
/ LAG(revenue) OVER (ORDER BY order_month) * 100, 1) AS growth_pct
FROM monthly_sales_summary
ORDER BY order_month;
 
Q20: Which product categories have the lowest customer review scores?
Review scores were analysed by product category. Only categories with at least 100 reviews were included, and each review was counted once within each category.
per category so multi-item orders do not weigh more)
SELECT category,
ROUND(AVG(review_score), 2) AS avg_review_score,
COUNT(*) AS reviews
FROM (
SELECT DISTINCT r.review_id,
r.review_score,
COALESCE(t.product_category_name_english, NULLIF(p.product_category_name, ''), 'unknown') AS category
FROM orders o
JOIN reviews r ON o.order_id = r.order_id
JOIN order_items oi ON o.order_id = oi.order_id
JOIN products p ON oi.product_id = p.product_id
LEFT JOIN category_translation t ON p.product_category_name = t.product_category_name
WHERE o.order_status = 'delivered'
) AS category_reviews
GROUP BY category
HAVING COUNT(*) >= 100
ORDER BY avg_review_score ASC
LIMIT 10;
 
Q21: How many delivered orders arrived later than the estimated date?
SELECT COUNT(*) AS delivered_orders,
SUM(order_delivered_customer_date > order_estimated_delivery_date) AS late_orders,
ROUND(100 * SUM(order_delivered_customer_date > order_estimated_delivery_date) / COUNT(*), 1) AS late_pct,
ROUND(AVG(DATEDIFF(order_delivered_customer_date, order_purchase_timestamp)), 1) AS avg_delivery_days
FROM orders
WHERE order_status = 'delivered'
AND order_delivered_customer_date IS NOT NULL;
 
